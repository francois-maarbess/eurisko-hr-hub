# Copy to .env and fill in. Never commit the real .env (it is gitignored).
# Database (SQLite file used by Prisma)
DATABASE_URL="file:./dev.db"

# Optional: enables the LLM provider for AI-assisted intake.
# Free key from https://console.groq.com. Without it, the built-in
# offline extractor handles everything.
# GROQ_API_KEY=gsk_paste_your_key_here
# Model is configurable without code changes (default openai/gpt-oss-20b;
# test openai/gpt-oss-120b with the same suite before committing to it).
# GROQ_MODEL=openai/gpt-oss-20b

# Assistant Router V2 rollout (no DB migration; instant rollback via env).
# false   = legacy (all tools, button-only confirms)
# shadow  = V2 routing logged + compared, legacy behavior served
# readonly= V2 for reads; write proposals paused with Admin-panel guidance
# full    = V2 fully enabled (default when unset): 3–10 tools per turn,
#           deterministic yes/no confirms, composite workflows, Retry-After
#           backoff, per-user queues, circuit breaker, intent-preserving
#           fallbacks. Mutations stay exactly-once + permission-checked.
# ASSISTANT_ROUTER_V2=full
# Tuning (defaults shown):
# ASSISTANT_CIRCUIT_THRESHOLD=5
# ASSISTANT_CIRCUIT_COOLDOWN_MS=30000

# Session lifetimes (defaults shown; unset = built-in default).
# ACCESS_TOKEN_TTL=15m
# REFRESH_TOKEN_TTL_DAYS=7

# Rate limits per IP per minute (defaults shown).
# THROTTLE_LIMIT=100
# THROTTLE_TTL_MS=60000
# LOGIN_THROTTLE_LIMIT=20
# MFA_THROTTLE_LIMIT=5
# SENSITIVE_THROTTLE_LIMIT=20
# AI_THROTTLE_LIMIT=30
# UPLOAD_THROTTLE_LIMIT=20
# Per-user live attachment quota in bytes (default 50MB).
# UPLOAD_QUOTA_BYTES=52428800
# Slow-route WARN threshold in ms for the HTTP access log.
# SLOW_LOG_MS=1000
# Reverse-proxy trust (hops). Default 1 for Render/Nginx; 0 = direct.
# TRUST_PROXY=1
# Distributed throttle store seam (week-5): memory is the default.
# THROTTLE_STORE=memory
# REDIS_URL=redis://localhost:6379

# Production CORS allow-list, comma-separated. Empty = reflect any
# origin (local development only — set this in production).
# CORS_ORIGINS=https://app.example.com

# Ports (defaults shown; backend honors PORT, frontend auto-picks free).
# PORT=3000
# VITE_PORT=5173

# Outbound webhook for the notification outbox (optional). When set, the
# delivery worker POSTs each durable event as JSON with an X-Idempotency-Key
# header, retrying with backoff before dead-lettering to FAILED (visible in
# Admin overview + GET /notifications/failed). Unset = events stay local-only
# in the in-app inbox; nothing breaks.
# NOTIFY_WEBHOOK_URL=https://hooks.example.com/hub
