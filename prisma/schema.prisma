generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  displayName  String
  passwordHash String?  // bcrypt hash; null = account not yet activated with a password
  platformRole String   @default("EMPLOYEE") // EMPLOYEE | SYSTEM_ADMIN
  active       Boolean  @default(true)
  mfaSecret    String?  // base32 TOTP secret; set at enrolment, live after verify
  mfaEnabled   Boolean  @default(false)
  mfaBackupCodes String? // JSON array of sha256 hashes, single-use
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  departmentMemberships DepartmentMember[]
  ownedRequests         Request[]         @relation("RequestOwner")
  claimedRequests       Request[]         @relation("RequestClaimant")
  documents             Document[]
  notifications         Notification[]
  staffNotes            StaffNote[]
  refreshTokens         RefreshToken[]
}

model Department {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members     DepartmentMember[]
  requestTypes RequestType[]
  requests     Request[]
}

model DepartmentMember {
  id             String   @id @default(cuid())
  userId         String
  departmentId   String
  departmentRole String   @default("AGENT") // AGENT | MANAGER
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user       User       @relation(fields: [userId], references: [id])
  department Department @relation(fields: [departmentId], references: [id])

  @@unique([userId, departmentId])
}

model RequestType {
  id           String   @id @default(cuid())
  departmentId String
  code         String
  name         String
  description  String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  department Department @relation(fields: [departmentId], references: [id])
  requests   Request[]

  @@unique([departmentId, code])
}

model Request {
  id             String   @id @default(cuid())
  employeeId     String
  departmentId   String
  requestTypeId  String
  title          String
  description    String
  priority       String   @default("STANDARD") // LOW | STANDARD | URGENT
  status         String   @default("PENDING")   // PENDING | IN_PROGRESS | COMPLETED | CANCELLED | REJECTED
  claimedById    String?
  resolutionNote String?
  rejectionReason String?
  completedAt    DateTime?
  rating         Int?
  feedbackNote   String?
  slaDueAt       DateTime?
  slaSource      String?   // 'AI' | 'RULE' — who set the deadline
  parentRequestId String?
  submissionKey String? @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  owner       User         @relation("RequestOwner", fields: [employeeId], references: [id])
  claimant    User?        @relation("RequestClaimant", fields: [claimedById], references: [id])
  department  Department   @relation(fields: [departmentId], references: [id])
  requestType RequestType  @relation(fields: [requestTypeId], references: [id])
  documents   Document[]
  auditLogs   AuditLog[]
  staffNotes  StaffNote[]
  parent      Request?     @relation("RequestChildren", fields: [parentRequestId], references: [id], onDelete: Restrict)
  children    Request[]    @relation("RequestChildren")

  @@index([employeeId, createdAt(sort: Desc)])
  @@index([departmentId, status, priority, createdAt])
  @@index([parentRequestId, status])
}

model StaffNote {
  id        String   @id @default(cuid())
  requestId String
  authorId  String
  content   String
  createdAt DateTime @default(now())

  request Request @relation(fields: [requestId], references: [id], onDelete: Cascade)
  author  User    @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([requestId, createdAt])
}

model Document {
  id               String    @id @default(cuid())
  requestId        String
  storageKey       String
  originalFilename String
  mimeType         String
  byteSize         Int
  checksum         String
  data             Bytes?
  uploadedBy       String
  purgeAt          DateTime
  deletedAt        DateTime?
  createdAt        DateTime  @default(now())

  request  Request @relation(fields: [requestId], references: [id])
  uploader User    @relation(fields: [uploadedBy], references: [id])

  @@index([requestId])
}

model AuditLog {
  id        String   @id @default(cuid())
  requestId String?
  actorId   String
  action    String
  oldValue  String?
  newValue  String?
  metadata  String?
  createdAt DateTime @default(now())

  request Request? @relation(fields: [requestId], references: [id])

  @@index([requestId])
  @@index([actorId])
}

model NotificationEvent {
  id             String    @id @default(cuid())
  requestId      String?
  eventType      String
  payload        String    @default("{}")
  status         String    @default("PENDING")
  attempts       Int       @default(0)
  lastError      String?
  idempotencyKey String    @unique
  sentAt         DateTime?
  createdAt      DateTime  @default(now())

  @@index([status, createdAt])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String
  title     String
  body      String
  requestId String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique // sha256 of the opaque token; plaintext never stored
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}
