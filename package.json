{
  "name": "eurisko-hr-hub",
  "version": "1.0.0",
  "description": "Internal Operations Service Hub",
  "private": true,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:seed": "npx tsx prisma/seed.ts",
    "prisma:studio": "prisma studio",
    "lint": "eslint src scripts test prisma/seed.ts",
    "test": "jest --runInBand --forceExit --detectOpenHandles",
    "test:cov": "jest --coverage --forceExit",
    "eval:ai": "npx tsx scripts/eval-ai.ts",
    "verify": "npx tsc --noEmit && npm run lint && npm test && npm run eval:ai && npm run build && npm run build --prefix frontend && npm run lint --prefix frontend",
    "db:reset": "prisma migrate reset --force && npx tsx prisma/seed.ts",
    "db:doctor": "npx tsx scripts/db-doctor.ts",
    "test:count": "npx tsx scripts/test-count.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/passport": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/throttler": "^6.7.0",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "^17.4.2",
    "helmet": "^8.3.0",
    "multer": "^2.4.0",
    "otpauth": "^9.5.2",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@swc/core": "^1.3.0",
    "@swc/jest": "^0.2.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.0.0",
    "@types/passport-jwt": "^4.0.0",
    "@types/supertest": "^6.0.0",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "jest": "^29.7.0",
    "prisma": "^6.19.3",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.0",
    "ts-node": "^10.9.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.70.1"
  }
}
